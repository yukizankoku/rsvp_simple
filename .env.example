# Supabase → Project Settings → API Keys
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Secret key (sb_secret_...), under "Secret keys". Server-only: never expose it to the browser.
SUPABASE_SECRET_KEY=

# Password for the admin dashboard and QR scanner (/login)
ADMIN_PASSWORD=

# Event details shown on the public page
EVENT_NAME=Event Name
EVENT_DATE=Saturday, 18 October 2026 · 9:00 AM WIB
EVENT_LOCATION=Venue Name, City

# Public URL of the app, used for links in emails (e.g. https://rsvp.bumitec.co.id).
# Optional: without it, the domain of the current request is used.
APP_URL=

# Email (SMTP). Gmail: smtp.gmail.com, port 465, SMTP_PASS = App Password (not your normal password).
# Without these, the app works but sends no email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Sender shown to guests. Defaults to SMTP_USER.
MAIL_FROM="BUMITEC <noreply@bumitec.co.id>"
