FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

DATABASE_URL=postgresql://postgres:password@localhost:5432/eo_management

# Public base URL used in invitation links / QR codes (no trailing slash).
# Leave empty to use the current request host.
APP_BASE_URL=

UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=10485760

# Set to 1 when served over HTTPS
SESSION_COOKIE_SECURE=0
